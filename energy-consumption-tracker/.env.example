# Copy to .env and fill in. All variables are optional — the app runs out of
# the box against the offline "fixture" source with none of these set.

# Free EIA API key (https://www.eia.gov/opendata/register.php). Required only
# to use the live "eia930" source. Either name works:
# EIA_API_KEY=your_key_here
# ENERGY_TRACKER_EIA_API_KEY=your_key_here

# Default source when a request doesn't specify one (fixture | eia930).
# ENERGY_TRACKER_DEFAULT_SOURCE=fixture

# Service-layer cache TTL in seconds.
# ENERGY_TRACKER_CACHE_TTL_SECONDS=300

# Outbound HTTP timeout in seconds for live sources.
# ENERGY_TRACKER_HTTP_TIMEOUT_SECONDS=30
